{
  "name": "interactive-text-editor",
  "version": "1.0.0",
  "description": "Aplicación Electron para gestión de contenido interactivo.",
  "main": "JavaScript/main.js",
  "author": "Tu Nombre",
  "license": "ISC",
  
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  
  "dependencies": {
    
  },
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  },

  "build": {
    "appId": "com.tuempresa.interactiveeditor",
    "productName": "Interactive Content Editor",
    "directories": {
      "output": "dist"
    },
    
    "files": [
      "JavaScript/**/*",
      "html/**/*",
      "config/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    
    "extraResources": [
        {
            "from": "recursos", 
            "to": "recursos",
            "filter": ["**/*"]
        }
    ],
    
    "win": {
      "target": "nsis",
      "icon": "imagenes/icon/icon.ico" 
    },
    
    "mac": {
      "target": "dmg",
      "icon": "imagenes/icon/icon.icns" 
    }
  }
}